# ==============================================================================
# B2B Lead Gen AI Pipeline - Environment Variables
# Copy this file to .env and insert your API credentials
# ==============================================================================

# Scraper API (PhantomBuster / Vayne)
SCRAPER_API_KEY=your_scraper_api_key_here
SCRAPER_RATE_LIMIT=100

# LLM ICP Semantic Auditor (OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# CRM Database Connection (Optional Direct Sync)
CRM_HOST=localhost
CRM_PORT=3306
CRM_DATABASE=crm_production
CRM_USER=read_user
CRM_PASSWORD=your_crm_password_here
